# FinShield — copy to .env and fill in. NEVER commit the real .env.

# --- PayPal (sandbox by default; developer.paypal.com → Apps & Credentials) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from developer dashboard after registering the webhook URL (leave empty until deploy)
PAYPAL_WEBHOOK_ID=
# Sandbox test accounts (business = merchant side, personal = the buyer that approves in the popup)
PAYPAL_SANDBOX_BUSINESS_EMAIL=
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# --- LLM analyst agent (any OpenAI-compatible endpoint; empty key = honest DEMO_FALLBACK mode) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- Backend ---
FINSHEILD_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FINSHEILD_DB_PATH=data/finshield.db
# auto | mock | real — adapter selection for the risk engine
FINSHEILD_USE_REAL=auto
